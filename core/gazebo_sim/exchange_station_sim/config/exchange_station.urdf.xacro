<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="exchange_station">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import exchange_station urdf file -->
    <xacro:include filename="$(find exchange_station)/urdf/exchange_station.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="exchange_station.ros2_control.xacro" />

    <gazebo>
        <xacro:include filename="exchange_station.gazebo_config.urdf" />
    </gazebo>

    <xacro:exchange_station_ros2_control name="GazeboSimSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
