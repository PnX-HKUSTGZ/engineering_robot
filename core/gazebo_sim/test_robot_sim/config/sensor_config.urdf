<robot name="test_robot">

  <link name="imu_sensor_link">
  </link>

  <joint name="imu_sensor_joint" type="fixed">
    <parent link="dummy"/>
    <child link="imu_sensor_link"/>
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
  </joint>

  <gazebo reference="imu_sensor_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>1</update_rate>
      <visualize>true</visualize>
      <topic>test_robot/imu</topic>
    </sensor>
    <plugin filename="libignition-gazebo-imu-system.so"
            name="ignition::gazebo::systems::Imu">
    </plugin>
  </gazebo>

  <link name="image_sensor_link">
  </link>
  <link name="image_sensor_real_link">
  </link>

  <joint name="image_sensor_real_joint" type="fixed">
    <parent link="image_sensor_link"/>
    <child link="image_sensor_real_link"/>
    <origin
      xyz="0 0 0"
      rpy="0 -1.570796327 0" />
  </joint>

  <joint name="image_sensor_joint" type="fixed">
    <parent link="dummy"/>
    <child link="image_sensor_link"/>
    <origin
      xyz="0 0 0.5"
      rpy="0 1.570796327 0" />
  </joint>

  <gazebo reference="image_sensor_real_link">
    <sensor name="camera_sensor" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>1440</width>
          <height>1080</height>
        </image>
        <format>B8G8R8</format>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>test_robot/image</topic>
    </sensor>
  </gazebo>


  <link name="lidar_sensor_link">
  </link>

  <link name="test_robot/dummy/gpu_lidar">
  </link>

  <joint name="lidar_sensor_res_joint" type="fixed">
    <parent link="lidar_sensor_link"/>
    <child link="test_robot/dummy/gpu_lidar"/>
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
  </joint>

  <joint name="lidar_sensor_joint" type="fixed">
    <parent link="dummy"/>
    <child link="lidar_sensor_link"/>
    <origin
      xyz="0 0 0.5"
      rpy="0 0 0" />
  </joint>

  <gazebo reference="lidar_sensor_link">
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>
    <sensor name='gpu_lidar' type='gpu_lidar'>
      <pose relative_to="lidar_sensor_link">0 0 0 0 0 0</pose>
      <topic>test_robot/lidar</topic>
      <update_rate>10</update_rate>
        <ray>
          <scan>
              <horizontal>
                <samples>3000</samples>
                <resolution>1</resolution>
                <min_angle>-0.8</min_angle>
                <max_angle>0.8</max_angle>
              </horizontal>
              <vertical>
                <samples>100</samples>
                <resolution>1</resolution>
                <min_angle>-0.89066</min_angle>
                <max_angle>0.209066</max_angle>
              </vertical>
          </scan>
          <range>
              <min>0.08</min>
              <max>4.0</max>
              <resolution>0.01</resolution>
          </range>
        </ray>
        <alwaysOn>1</alwaysOn>
        <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
